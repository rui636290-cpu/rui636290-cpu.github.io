---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { profile, aboutMe, capabilities } from '../data/profile';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.priority - b.data.priority || b.data.lastUpdated.getTime() - a.data.lastUpdated.getTime());
const featured = projects.filter((project) => project.data.featured);
---

<BaseLayout>
  <div class="home-layout">
    <aside class="sidebar">
      <h1 class="sidebar-name">{profile.name}</h1>
      <p class="sidebar-role">{profile.target}</p>
      <p class="sidebar-city">{profile.city}</p>
      <p class="sidebar-intro">{profile.subtitle}</p>

      <ul class="sidebar-nav">
        <li><a href="#capabilities">能力证据</a></li>
        <li><a href="#projects">代表项目</a></li>
        <li><a href="#experience">实习经历</a></li>
        <li><a href="#about">关于</a></li>
      </ul>

      <div class="sidebar-perm">
        <a href="/resume/">在线简历 →</a>
        <a href={`mailto:${profile.email}`}>邮箱联系 →</a>
      </div>
    </aside>

    <div class="content">
      <!-- Capabilities: numbered text lines -->
      <section id="capabilities" aria-labelledby="cap-title">
        <div class="section-heading">
          <p class="eyebrow">能力证据</p>
          <h2 id="cap-title">三项能力，基于真实经历</h2>
        </div>
        <ol class="cap-list">
          {capabilities.map((cap) => (
            <li><strong>{cap.title}</strong> — {cap.description}</li>
          ))}
        </ol>
      </section>

      <!-- Featured project -->
      <section id="projects" aria-labelledby="projects-title">
        <div class="section-heading">
          <p class="eyebrow">代表项目</p>
          <h2 id="projects-title">项目经历</h2>
        </div>
        {featured.length > 0 ? (
          featured.map((project, index) => <ProjectCard project={project} index={index} />)
        ) : (
          <p style="color:var(--muted)">暂无已发布项目。</p>
        )}
      </section>

      <!-- Work experience -->
      <section id="experience" aria-labelledby="exp-title">
        <div class="section-heading">
          <p class="eyebrow">经历</p>
          <h2 id="exp-title">实习经历</h2>
        </div>
        <div class="exp-block">
          <span class="exp-company">义乌市屹辉服饰有限公司</span>
          <p class="exp-meta">2025.06 — 2025.09 · 浙江义乌</p>
          <h3>天猫运营实习生</h3>
          <p>负责天猫防晒用品类目运营，围绕商品运营、市场分析、产品规划和数据整理开展工作，参与细分类目的产品布局与运营策略制定。</p>
          <ul>
            <li>商品上架、信息维护、标题优化、图片优化和日常运营数据整理</li>
            <li>参与基础付费推广调整，根据商品表现和推广数据协助完成日常优化</li>
            <li>分析不同价格区间的销量占比及变化趋势，参与制定产品价格定位方案，减少单纯依赖低价竞争</li>
            <li>拆解类目 TOP 竞品的产品结构、价格策略、核心卖点和市场定位，为产品规划提供参考</li>
            <li>根据历史销售数据和市场变化，协助团队分析并优化细分类目的产品布局</li>
          </ul>
        </div>
      </section>

      <!-- About + Education -->
      <section id="about" aria-labelledby="about-title">
        <div class="section-heading">
          <p class="eyebrow">关于</p>
          <h2 id="about-title">关于我</h2>
        </div>
        <div class="about-block">
          <p>{aboutMe.summary}</p>
          <p>{profile.school} · {profile.major} · {profile.education}</p>
        </div>
      </section>

      <!-- Contact -->
      <ContactCTA />
    </div>
  </div>
</BaseLayout>
