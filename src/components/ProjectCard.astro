---
interface Props {
  project: {
    data: {
      title: string;
      slug: string;
      summary: string;
      status: string;
      role: string;
      tags: string[];
      problem: string;
      results: string[];
    };
  };
  index?: number;
}

const { project } = Astro.props;
const d = project.data;
const statusLabels: Record<string, string> = {
  idea: '构想', planning: '规划中', prototype: '原型中', development: '开发中',
  alpha: 'Alpha', testing: '测试中', released: '已完成', archived: '已归档',
};
---

<article class="project-featured">
  <span class="pf-label">{statusLabels[d.status] ?? d.status}</span>
  <h3>{d.title}</h3>
  <p class="pf-summary">{d.summary}</p>
  <div class="pf-meta">
    <span>{d.role}</span>
    {d.tags.length > 0 && <span>{d.tags.slice(0, 4).join(' · ')}</span>}
  </div>
  <dl class="pf-grid">
    <div class="pf-field">
      <dt>问题</dt>
      <dd>{d.problem}</dd>
    </div>
    <div class="pf-field">
      <dt>我的工作</dt>
      <dd>{d.role}</dd>
    </div>
    <div class="pf-field">
      <dt>已确认产出</dt>
      <dd>
        <ul>
          {d.results.slice(0, 4).map((item: string) => <li>{item}</li>)}
        </ul>
      </dd>
    </div>
  </dl>
  <a class="pf-link" href={`/projects/${d.slug}/`}>阅读完整案例 →</a>
</article>
